# OpenAI API Key (Required for embeddings and answering questions)
# If left empty, you must provide it through the Frontend UI settings panel.

# Ollama LLM Model name (e.g., llama3, llama3.1, llama3.2, mistral)
LLM_MODEL=phi3:mini

# Chroma DB persistence path
CHROMA_DB_DIR=./data/chroma_db

# FastAPI server port
PORT=8000
